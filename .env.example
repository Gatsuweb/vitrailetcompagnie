# Domaine public, une fois connu (ex. https://vitrail-et-compagnie.fr)
NEXT_PUBLIC_SITE_URL=
# Secret de connexion à l’espace admin
ADMIN_PASSWORD=
# Accès distinct pour Valérie, avec les mêmes droits de publication
ADMIN_CLIENT_PASSWORD=
ADMIN_SESSION_SECRET=
# Répertoire persistant et sauvegardé sur l’hébergement (facultatif en local)
SITE_DATA_DIR=

# L’accès Mon Compte Pro sert à créer manuellement les étiquettes après confirmation.
# Le parcours actuel prévoit l’édition manuelle des étiquettes dans les espaces transporteurs.
# Ne jamais mettre les futurs identifiants dans des variables NEXT_PUBLIC_.

